#!/usr/bin/env bash
# MindfulFleet update control.
#   mindful-fleet status         show installed and latest versions, and the update setting
#   mindful-fleet update         update now
#   mindful-fleet hold           stop automatic updates on this computer
#   mindful-fleet skip           skip the latest version, and take the next one after it
#   mindful-fleet resume         turn automatic updates back on and clear any skip
#   mindful-fleet every hourly|6h|daily|weekly   how often to check for updates
#   mindful-fleet xmrig          turn on XMRig's read-only API so the dashboard shows hashrate
#   mindful-fleet password       choose or change the dashboard password (on the hub)
#   mindful-fleet password off   turn the dashboard password off (on the hub)
#   mindful-fleet tidy           free up space (asks first); 'tidy undo' removes the log cap it can add
#   mindful-fleet wifi-watchdog on|off|status   reconnect Wi-Fi by itself when this Pi loses the router
set -euo pipefail

REPO="MindfulTechSupport/mindfulfleet"
CHANNEL="${MINDFUL_FLEET_CHANNEL:-release}"
CONF=/etc/mindful-fleet/update.conf
DROPIN=/etc/systemd/system/mindful-fleet-update.timer.d/interval.conf

installed() { cat /opt/mindful-fleet/VERSION 2>/dev/null || echo "unknown"; }
latest() { curl -fsSL --proto "=https" --tlsv1.2 --max-time 20 "https://raw.githubusercontent.com/$REPO/$CHANNEL/VERSION" | tr -d '[:space:]'; }
setting() { sed -n "s/^$1=//p" "$CONF" 2>/dev/null | tail -1; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }
need_root() { [ "$(id -u)" -eq 0 ] || { echo "Please run with sudo." >&2; exit 1; }; }
save() {
  need_root
  install -d -m 755 /etc/mindful-fleet
  printf 'AUTO_UPDATE=%s\nSKIP_VERSION=%s\nINTERVAL=%s\n' "$1" "$2" "${3:-$(setting INTERVAL | grep . || echo daily)}" > "$CONF"
}

case "${1:-status}" in
  status)
    LATEST="$(latest || echo "unknown")"
    echo "Installed: $(installed)"
    echo "Latest:    $LATEST"
    echo "Automatic updates: $( [ "$(setting AUTO_UPDATE)" = off ] && echo "on hold" || echo "on")"
    echo "Checks:    $(setting INTERVAL | grep . || echo daily)"
    SKIP="$(setting SKIP_VERSION)"
    [ -n "$SKIP" ] && echo "Skipping:  $SKIP"
    ;;
  hold)
    save off "$(setting SKIP_VERSION)"
    echo "Automatic updates are on hold. This computer stays on $(installed). Run 'sudo mindful-fleet resume' to turn them back on."
    ;;
  resume)
    save on ""
    echo "Automatic updates are on."
    ;;
  skip)
    LATEST="$(latest)"
    save "$(setting AUTO_UPDATE | grep . || echo on)" "$LATEST"
    echo "Skipping $LATEST. This computer will update again when a newer version comes out."
    ;;
  every)
    # A random delay spreads a fleet out, so they don't all restart at once.
    case "${2:-}" in
      hourly) WHEN=hourly; SPREAD=10min ;;
      6h) WHEN="*-*-* 00/6:00:00"; SPREAD=1h ;;
      daily) WHEN=daily; SPREAD=6h ;;
      weekly) WHEN=weekly; SPREAD=12h ;;
      *) echo "Usage: mindful-fleet every hourly | 6h | daily | weekly" >&2; exit 1 ;;
    esac
    save "$(setting AUTO_UPDATE | grep . || echo on)" "$(setting SKIP_VERSION)" "$2"
    install -d -m 755 "$(dirname "$DROPIN")"
    printf '[Timer]\nOnCalendar=\nOnCalendar=%s\nRandomizedDelaySec=%s\n' "$WHEN" "$SPREAD" > "$DROPIN"
    systemctl daemon-reload
    systemctl restart mindful-fleet-update.timer
    echo "This computer now checks for updates $2, give or take $SPREAD."
    ;;
  xmrig)
    need_root
    shift
    exec python3 /opt/mindful-fleet/xmrig-api.py "$@"
    ;;
  password)
    need_root
    [ -f /etc/mindful-fleet/hub.env ] || { echo "This computer isn't the hub. Run this on the computer that shows the dashboard." >&2; exit 1; }
    STATE="$(sed -n 's/^MINDFUL_FLEET_STATE=//p' /etc/mindful-fleet/hub.env | tail -1)"
    STATE="${STATE:-/var/lib/mindful-fleet/fleet.json}"
    FILE="$(dirname "$STATE")/password.json"
    if [ "${2:-}" = "off" ]; then
      [ -f "$FILE" ] || { echo "There's no dashboard password to turn off."; exit 0; }
      KEPT="$FILE.off-$(date +%Y%m%d-%H%M%S)"
      mv "$FILE" "$KEPT"
      echo "Dashboard password is off: anyone on your network can open the dashboard."
      echo "To turn it back on with the same password: sudo mv $KEPT $FILE"
      exit 0
    fi
    # The hub's own code writes the file and hands it to the hub's account before putting it in place.
    MINDFUL_FLEET_STATE="$STATE" python3 /opt/mindful-fleet/hub/mindful_fleet_hub.py --set-password
    ;;
  tidy)
    need_root
    TOOLS=/opt/mindful-fleet/tools/mindful_fleet_tools.py
    [ -f "$TOOLS" ] || { echo "Update MindfulFleet first: sudo mindful-fleet update" >&2; exit 1; }
    if [ "${2:-}" = "undo" ]; then python3 "$TOOLS" tidy-undo; else python3 "$TOOLS" tidy; fi
    ;;
  wifi-watchdog)
    UNIT=mindful-fleet-wifi-watchdog
    case "${2:-status}" in
      on)
        need_root
        [ -f /opt/mindful-fleet/tools/mindful_fleet_tools.py ] || { echo "Update MindfulFleet first: sudo mindful-fleet update" >&2; exit 1; }
        cat > "/etc/systemd/system/$UNIT.service" <<'EOF'
[Unit]
Description=MindfulFleet Wi-Fi watchdog (reconnects Wi-Fi when the router can't be reached)

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/mindful-fleet/tools/mindful_fleet_tools.py wifi-check
EOF
        cat > "/etc/systemd/system/$UNIT.timer" <<'EOF'
[Unit]
Description=Run the MindfulFleet Wi-Fi watchdog every 2 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOF
        systemctl daemon-reload
        systemctl enable --now "$UNIT.timer" >/dev/null
        echo "Wi-Fi watchdog is on. If this Pi can't reach its router for about 6 minutes, it restarts Wi-Fi;"
        echo "after 3 restarts that don't help, it reboots (at most once an hour). See what it did: journalctl -u $UNIT"
        ;;
      off)
        need_root
        systemctl disable --now "$UNIT.timer" >/dev/null 2>&1 || true
        rm -f "/etc/systemd/system/$UNIT.service" "/etc/systemd/system/$UNIT.timer"
        systemctl daemon-reload
        echo "Wi-Fi watchdog is off."
        ;;
      status)
        if systemctl is-enabled "$UNIT.timer" >/dev/null 2>&1; then echo "Wi-Fi watchdog: on"; else echo "Wi-Fi watchdog: off"; fi
        ;;
      *) echo "Usage: mindful-fleet wifi-watchdog on | off | status" >&2; exit 1 ;;
    esac
    ;;
  update)
    need_root
    LATEST="$(latest)" || { echo "Couldn't check for updates." >&2; exit 1; }
    CURRENT="$(installed)"
    if [ "${2:-}" = "--auto" ]; then
      [ "$(setting AUTO_UPDATE)" = off ] && { echo "Updates are on hold."; exit 0; }
      [ "$LATEST" = "$(setting SKIP_VERSION)" ] && { echo "Skipping $LATEST as asked."; exit 0; }
    fi
    if ! newer "$LATEST" "$CURRENT" && [ "$CURRENT" != "unknown" ]; then
      echo "Already up to date ($CURRENT)."
      exit 0
    fi
    echo "Updating from $CURRENT to $LATEST."
    curl -fsSL --proto "=https" --tlsv1.2 "https://raw.githubusercontent.com/$REPO/$CHANNEL/install.sh" | MINDFUL_FLEET_CHANNEL="$CHANNEL" bash -s -- update
    ;;
  *)
    echo "Usage: mindful-fleet status | update | hold | skip | resume | every hourly|6h|daily|weekly | xmrig | password [off] | tidy [undo] | wifi-watchdog on|off|status" >&2
    exit 1
    ;;
esac
